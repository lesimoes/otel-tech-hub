discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/otel-app.*"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {"source" = "alloy-docker"}
  forward_to = [loki.process.docker_logs.receiver]
}

loki.process "docker_logs" {
  forward_to = [loki.write.loki.receiver]

  stage.regex {
    expression = "trace_id=(?P<trace_id>[a-f0-9]{32})"
  }

  stage.labels {
    values = { trace_id = "" }
  }
}

otelcol.receiver.otlp "from_collector" {
  http {
    endpoint = "0.0.0.0:4319"
  }

  output {
    logs = [otelcol.exporter.loki.otel_logs.input]
  }
}

otelcol.exporter.loki "otel_logs" {
  forward_to = [loki.process.otel_logs.receiver]
}

loki.process "otel_logs" {
  forward_to = [loki.write.loki.receiver]

  stage.static_labels {
    values = {
      source = "alloy-otel",
    }
  }

  stage.regex {
    expression = "trace_id=(?P<trace_id>[a-f0-9]{32})"
  }

  stage.labels {
    values = { trace_id = "" }
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
